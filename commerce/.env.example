# Set separate values in the test and production projects. Never commit secrets.
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
# Required in test mode: random private client_reference_id for the test link.
# Other sandbox payments never issue a licence. Omit in live mode.
STRIPE_TEST_REFERENCE=
STRIPE_PAYMENT_LINK_ID=
STRIPE_PRICE_ID=
STRIPE_CURRENCIES=eur,usd,cad
LICENSE_KEY_ID=commerce-2026
# Base64 raw 32-byte Ed25519 seed. Public half is also embedded in the Mac app.
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=
RESEND_API_KEY=
MAIL_FROM=PressTalk <licenses@presstalk.app>
MAIL_REPLY_TO=help@presstalk.app
PUBLIC_ORIGIN=
RECOVERY_PEPPER=
CRON_SECRET=
# Enable checkout only after the deployment acceptance script passes.
SALES_ENABLED=false
