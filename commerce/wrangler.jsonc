{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "presstalk-licenses",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": false },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{
    "binding": "ORDERS",
    "database_name": "presstalk-orders",
    "migrations_dir": "migrations"
  }]
  // Add the real D1 database_id returned by provisioning before deployment.
  // Runtime secrets and exact test/live configuration are supplied separately.
}
